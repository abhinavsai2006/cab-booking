# ==========================================
# CAB BOOKING APP - ENVIRONMENT CONFIGURATION
# ==========================================

# Mode
NODE_ENV=development
DEMO_MODE=true

# Database (PostgreSQL)
# Local default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cab_app?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API & Web URLs
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Clerk)
# In DEMO_MODE=true, the app automatically allows simulated instant switching
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"
CLERK_WEBHOOK_SECRET="whsec_placeholder"

# Maps Provider (osm | google)
MAP_PROVIDER="osm"
NEXT_PUBLIC_MAP_PROVIDER="osm"
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="placeholder"
VAPID_PRIVATE_KEY="placeholder"
VAPID_SUBJECT="mailto:support@cabapp.local"

# Email (Resend)
RESEND_API_KEY=""

# Twilio (Optional SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
